# ─────────────────────────────────────────
#  JointNet — Environment Configuration
#  (On Render, set these under Environment. Never commit a real .env.)
# ─────────────────────────────────────────

BOT_TOKEN=your_bot_token_here
GUILD_ID=your_guild_id_here
OWNER_ID=your_user_id_here

# Channels (right-click channel → Copy Channel ID)
LEVEL_CHANNEL_ID=              # /threatlevel posts here
SCHEDULE_CHANNEL_ID=           # /schedule posts here
EVENTS_CHANNEL_ID=             # /event (Ceremonial, Deployments, Trainings)
CIVIL_DEPLOYMENT_CHANNEL_ID=   # /event type: Civil Deployments
REQUESTS_CHANNEL_ID=           # /request results (staff review channel)

# Who can do what. Comma-separated role IDs. Server Administrators and OWNER_ID always pass.
STAFF_ROLE_IDS=                # can use /event, /schedule and Accept/Deny requests
THREAT_ROLE_IDS=               # can use /threatlevel

# Role given when a request is accepted. If blank, the bot looks for a role named "Cleared".
CLEARED_ROLE_ID=

# Optional: role pinged when a new request comes in
REQUESTS_PING_ROLE_ID=

# MongoDB Atlas connection string (keeps data across Render restarts).
# Leave blank only for local testing — data is then stored in /data and is lost on Render restarts.
MONGODB_URI=
